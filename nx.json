{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/tsconfig.browser.json",
      "{workspaceRoot}/tsconfig.node.json",
      "{workspaceRoot}/eslint.config.ts",
      "{workspaceRoot}/tooling/checks/eslint-boundaries.ts",
      "{workspaceRoot}/.nvmrc",
      "{workspaceRoot}/pnpm-workspace.yaml",
      "{workspaceRoot}/.github/workflows/**/*",
      "{workspaceRoot}/.github/actions/**/*"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/**/test/**",
      "!{projectRoot}/**/*.stories.tsx"
    ],
    "storybook": [
      "default",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/**/test/**"
    ],
    "gateScripts": [
      "{workspaceRoot}/tooling/**/*",
      "{workspaceRoot}/packages/ui-catalog/src/**/*"
    ]
  },
  "plugins": [
    {
      "plugin": "@nx/vite/plugin",
      "options": {
        "buildTargetName": "build",
        "serveTargetName": "serve",
        "testTargetName": "test"
      },
      "exclude": ["tooling/fixtures/**"]
    }
  ],
  "targetDefaults": {
    "typecheck": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/tsconfig.base.json"]
    },
    "build": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/tsconfig.base.json"
      ]
    },
    "test": {
      "cache": true,
      "inputs": ["default", "^production"]
    },
    "lint": {
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/apps/*/project.json",
        "{workspaceRoot}/packages/*/project.json",
        "{workspaceRoot}/apps/*/package.json",
        "{workspaceRoot}/packages/*/package.json",
        "{workspaceRoot}/tooling/**/package.json",
        "{workspaceRoot}/tooling/**/project.json",
        "{workspaceRoot}/tests/*/package.json",
        "{workspaceRoot}/tests/*/project.json"
      ]
    },
    "build-storybook": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": [
        "storybook",
        "^production",
        "{workspaceRoot}/tsconfig.base.json"
      ]
    },
    "storybook": {
      "cache": false
    },
    "serve": {
      "cache": false
    }
  },
  "defaultBase": "main",
  "release": {
    "projects": ["ui", "undo-machine", "agent-stream", "reorder-desk"],
    "version": {
      "generatorOptions": {
        "currentVersionResolver": "git-tag"
      }
    },
    "changelog": {
      "workspaceChangelog": {
        "createRelease": false
      }
    },
    "releaseTagPattern": "v{version}"
  }
}
