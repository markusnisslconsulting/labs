# Same host family as the main site, same two guards.

# The host otherwise recombines scripts into two copies of React and
# breaks hydration on any page with a lazy chunk.
<IfModule pagespeed_module>
  ModPagespeed off
</IfModule>

# Prerendered pages and client-side routes cost no redirect.
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Directory entry without the slash (DirectorySlash is off): the
  # hosted workbench lives at /storybook/, so send /storybook to
  # /storybook/ with one redirect. Relative asset paths stay correct.
  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
  RewriteRule ^(.*)$ $1/ [R=301,L]

  # Single-page app: every path serves the shell, the router takes it
  # from there.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /index.html [L]
</IfModule>
