{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits"],
  "schedule": ["weekly"],
  "rangeStrategy": "pin",
  "packageRules": [
    {
      "description": "Major updates als separater PR ohne Automerge",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Dev dependencies: patch and minor automatically, when tests are green",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Storybook/React-Familie gebuendelt",
      "matchPackagePatterns": [
        "^@storybook/",
        "^storybook$",
        "^react",
        "^@base-ui-components/"
      ],
      "groupName": "ui-ecosystem"
    }
  ]
}
