{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "undo-machine",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/undo-machine/tsconfig.lib.json --noEmit"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/undo-machine/tsconfig.lib.json --outDir packages/undo-machine/dist"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run packages/undo-machine/test --root ."
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint packages/undo-machine --max-warnings 0"
      }
    }
  },
  "tags": ["scope:shared", "type:feature"]
}
