{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "agent-stream",
  "tags": ["scope:shared", "type:feature"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/agent-stream/tsconfig.lib.json --noEmit"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run packages/agent-stream/test --root ."
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint packages/agent-stream --max-warnings 0"
      }
    }
  }
}
