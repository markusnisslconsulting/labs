{
  "name": "brand",
  "tags": ["scope:shared", "type:contract", "env:neutral"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx packages/brand/scripts/build.ts"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx packages/brand/scripts/build.ts --generate"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint packages/brand --max-warnings 0"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/brand/tsconfig.json --noEmit"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "vitest run packages/brand/test --root ."
      },
      "inputs": [
        "default",
        "{workspaceRoot}/packages/ui/src/styles/tokens/*.css",
        "{workspaceRoot}/apps/site/public/logo.webp",
        "{workspaceRoot}/packages/ui/.storybook/public/logo.webp"
      ]
    }
  }
}
