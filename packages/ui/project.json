{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "ui",
  "tags": ["scope:shared", "type:ui"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^build"],
      "options": {
        "commands": [
          "vite build --config packages/ui/vite.config.ts",
          "tsc -p packages/ui/tsconfig.build.json",
          "node scripts/prepare-dist.mjs packages/ui dist/packages/ui"
        ],
        "parallel": false
      },
      "outputs": ["{workspaceRoot}/dist/packages/ui"],
      "inputs": [
        "production",
        "{workspaceRoot}/tsconfig.base.json",
        "gateScripts"
      ]
    },
    "build-storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "storybook build -c packages/ui/.storybook --output-dir dist/packages/ui-storybook --stats-json",
        "cwd": "."
      },
      "outputs": ["{workspaceRoot}/dist/packages/ui-storybook"]
    },
    "contrast-check": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "tsx scripts/tokens/contrast.ts check",
        "cwd": "{workspaceRoot}"
      },
      "inputs": ["default", "^default", "gateScripts"]
    },
    "contrast-report": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx scripts/tokens/contrast.ts report",
        "cwd": "{workspaceRoot}"
      },
      "inputs": ["default", "^default", "gateScripts"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint packages/ui --max-warnings 0"
      }
    },
    "snapshot-budget": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "tsx scripts/stories/snapshots.ts check",
        "cwd": "{workspaceRoot}"
      },
      "inputs": ["default", "^default", "gateScripts"]
    },
    "snapshot-budget-report": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx scripts/stories/snapshots.ts report",
        "cwd": "{workspaceRoot}"
      },
      "inputs": ["default", "^default", "gateScripts"]
    },
    "snapshot-budget-write": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx scripts/stories/snapshots.ts write-budget",
        "cwd": "{workspaceRoot}"
      },
      "inputs": ["default", "^default", "gateScripts"]
    },
    "story-coverage": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "tsx scripts/stories/coverage.ts check",
        "cwd": "{workspaceRoot}"
      },
      "inputs": ["default", "^default", "gateScripts"]
    },
    "story-coverage-report": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx scripts/stories/coverage.ts report",
        "cwd": "{workspaceRoot}"
      },
      "inputs": ["default", "^default", "gateScripts"]
    },
    "storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "storybook dev -c packages/ui/.storybook -p 4400"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run packages/ui/test/ --root ."
      },
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/AGENTS.md",
        "{workspaceRoot}/CONTRIBUTING.md",
        "{workspaceRoot}/docs/roadmap.md",
        "{workspaceRoot}/docs/screen-reader-pass.md",
        "{workspaceRoot}/nx.json"
      ]
    },
    "test-storybook": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "packages/ui",
        "commands": [
          "vitest run --config vitest.storybook.config.ts",
          "VITE_LABS_THEME=dark vitest run --config vitest.storybook.config.ts"
        ],
        "parallel": false
      }
    },
    "tokens-baseline": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx scripts/tokens/usage.ts baseline",
        "cwd": "{workspaceRoot}"
      },
      "inputs": ["default", "^default", "gateScripts"]
    },
    "tokens-check": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "tsx scripts/tokens/usage.ts check",
        "cwd": "{workspaceRoot}"
      },
      "inputs": ["default", "^default", "gateScripts"]
    },
    "tokens-report": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx scripts/tokens/usage.ts report",
        "cwd": "{workspaceRoot}"
      },
      "inputs": ["default", "^default", "gateScripts"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/ui/tsconfig.json --noEmit"
      }
    },
    "visual-serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "http-server dist/packages/ui-storybook -p 4520 --silent"
      }
    },
    "visual-test": {
      "dependsOn": ["build-storybook"],
      "executor": "nx:run-commands",
      "options": {
        "command": "concurrently -k -s first \"http-server dist/packages/ui-storybook -p 4520 --silent\" \"wait-on tcp:127.0.0.1:4520 && pnpm exec playwright test --config visual/playwright.config.ts\""
      }
    },
    "visual-update": {
      "dependsOn": ["build-storybook"],
      "executor": "nx:run-commands",
      "options": {
        "command": "concurrently -k -s first \"http-server dist/packages/ui-storybook -p 4520 --silent\" \"wait-on tcp:127.0.0.1:4520 && pnpm exec playwright test --config visual/playwright.config.ts --update-snapshots\""
      }
    },
    "browser-test": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-storybook"],
      "options": {
        "command": "concurrently -k -s first \"http-server dist/packages/ui-storybook -p 4414 --silent\" \"wait-on tcp:127.0.0.1:4414 && pnpm exec playwright test --config packages/ui/playwright.browser.config.ts\""
      }
    },
    "tokens-dtcg": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "tsx scripts/tokens/dtcg.ts check"
      },
      "inputs": ["default", "^default", "gateScripts"]
    },
    "tokens-dtcg-write": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx scripts/tokens/dtcg.ts write"
      },
      "inputs": ["default", "^default", "gateScripts"]
    },
    "package-check": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["build"],
      "options": {
        "cwd": "dist/packages/ui",
        "commands": [
          "pnpm exec publint --strict",
          "pnpm exec attw --pack . --profile esm-only --exclude-entrypoints styles.css styles/* tokens/*"
        ],
        "parallel": false
      }
    },
    "tokens-codemod": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx scripts/tokens/codemod.ts report"
      },
      "inputs": ["default", "^default", "gateScripts"]
    },
    "tokens-codemod-write": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx scripts/tokens/codemod.ts write"
      },
      "inputs": ["default", "^default", "gateScripts"]
    },
    "adoption": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "tsx scripts/adoption.ts check"
      },
      "inputs": ["default", "^default", "gateScripts"]
    },
    "adoption-report": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx scripts/adoption.ts report"
      },
      "inputs": ["default", "^default", "gateScripts"]
    },
    "adoption-write-floor": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx scripts/adoption.ts write-floor"
      },
      "inputs": ["default", "^default", "gateScripts"]
    },
    "visual-sweep": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-storybook"],
      "options": {
        "command": "concurrently -k -s first \"http-server dist/packages/ui-storybook -p 4530 --silent\" \"wait-on tcp:127.0.0.1:4530 && SWEEP_OUT=${SWEEP_OUT:-.visual-sweep} pnpm exec playwright test --config scripts/visual/sweep.config.ts\""
      },
      "inputs": ["default", "^default", "gateScripts"]
    },
    "visual-axes": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-storybook"],
      "options": {
        "command": "concurrently -k -s first \"http-server dist/packages/ui-storybook -p 4530 --silent\" \"wait-on tcp:127.0.0.1:4530 && SWEEP_OUT=${SWEEP_OUT:-.visual-axes} pnpm exec playwright test --config scripts/visual/axes.config.ts\""
      },
      "inputs": ["default", "^default", "gateScripts"]
    },
    "inventory": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx scripts/inventory.ts check"
      },
      "inputs": ["default", "^default", "gateScripts"]
    },
    "inventory-write": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx scripts/inventory.ts write"
      },
      "inputs": ["default", "^default", "gateScripts"]
    },
    "api-surface": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "tsx scripts/api-surface.ts check"
      },
      "inputs": ["default", "^default", "gateScripts"]
    },
    "api-surface-write": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "tsx scripts/api-surface.ts write"
      },
      "inputs": ["default", "^default", "gateScripts"]
    }
  }
}
