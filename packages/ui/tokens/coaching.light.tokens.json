{
  "$description": "Brand override: coaching. Theme: light. Generated.",
  "semantic": {
    "accent": {
      "$type": "color",
      "$value": "{primitive.teal.600}",
      "$description": "Brand accent; the coaching brand re-points it to teal"
    },
    "radius": {
      "inset": {
        "$type": "dimension",
        "$value": "0.5rem",
        "$description": "A shape inside another shape"
      },
      "control": {
        "$type": "dimension",
        "$value": "1rem",
        "$description": "An interactive box"
      },
      "surface": {
        "$type": "dimension",
        "$value": "1rem",
        "$description": "A floating or banded surface"
      },
      "container": {
        "$type": "dimension",
        "$value": "1.5rem",
        "$description": "A container that holds content"
      }
    },
    "font": {
      "display": {
        "$type": "fontFamily",
        "$value": "\"Hoefler Text\", \"Iowan Old Style\", Palatino, Charter, Georgia, serif",
        "$description": "Headings"
      }
    },
    "elevation": {
      "raised": {
        "$type": "shadow",
        "$value": {
          "offsetX": "0",
          "offsetY": "2px",
          "blur": "10px",
          "spread": "0",
          "color": "rgba(15, 95, 107, 0.1)"
        },
        "$description": "Lifted off the page"
      },
      "overlay": {
        "$type": "shadow",
        "$value": {
          "offsetX": "0",
          "offsetY": "12px",
          "blur": "32px",
          "spread": "0",
          "color": "rgba(15, 95, 107, 0.14)"
        },
        "$description": "Floating above the page"
      },
      "modal": {
        "$type": "shadow",
        "$value": {
          "offsetX": "0",
          "offsetY": "24px",
          "blur": "60px",
          "spread": "0",
          "color": "rgba(15, 95, 107, 0.2)"
        },
        "$description": "Above everything"
      }
    },
    "density": {
      "$type": "number",
      "$value": "1.12",
      "$description": "Spacing multiplier; data-density=compact sets 0.72"
    }
  }
}
