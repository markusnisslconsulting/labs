{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "tools",
  "tags": ["scope:shared", "type:tooling", "env:node"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint tooling/build --max-warnings 0"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tooling/build/tsconfig.json --noEmit"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run tooling/build/test/ --root ."
      }
    }
  }
}
