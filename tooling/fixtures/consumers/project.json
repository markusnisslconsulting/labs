{
  "name": "consumer-fixtures",
  "tags": ["scope:shared", "type:tooling", "env:node"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint tooling/fixtures/consumers --max-warnings 0"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tooling/fixtures/consumers/tsconfig.json --noEmit"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": ["ui"],
          "target": "build"
        }
      ],
      "inputs": ["default", "^production", "gateScripts"],
      "options": {
        "command": "node tooling/fixtures/consumers/check.mjs"
      }
    }
  }
}
